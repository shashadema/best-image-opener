{
  "manifest_version": 3,
  "name": "原图助手 · Best Image Opener",
  "short_name": "原图助手",
  "version": "1.0.7",
  "description": "右键在新标签页打开图片时自动换成最高画质原图；支持懒加载、srcset、背景图，并解除常见的右键限制。",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "storage",
    "tabs",
    "scripting",
    "downloads",
    "clipboardWrite",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/resolver.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "原图助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  }
}
